{
  "manifest_version": 2,
  "name": "Pomodoro",
  "version": "1.0.1",
  "description": "Temporizador Pomodoro con tiempos configurables de estudio y descanso, estilo Windows 11.",
  "author": "octa",
  "browser_specific_settings": {
    "gecko": {
      "id": "pomodoro-zen@octa",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "48": "icons/timer.svg",
    "96": "icons/timer.svg"
  },
  "permissions": [
    "storage",
    "notifications",
    "theme"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": ["popup/cat/*.png"],
  "browser_action": {
    "default_title": "Pomodoro",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/timer.svg"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "commands": {
    "toggle-timer": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Iniciar/pausar el Pomodoro"
    }
  }
}
